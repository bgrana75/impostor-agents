    "judge": "tsx src/sim/judge.ts",
    "report3": "tsx src/sim/report3.ts",
    "report": "tsx src/sim/report.ts"
  },
  "license": "MIT",
  "dependencies": {
    "node-llama-cpp": "^3.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
